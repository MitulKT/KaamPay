# MongoDB (Atlas free tier works). Use mongomock:// for an in-memory demo (data lost on restart).
MONGO_URL=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net
DB_NAME=kaampay

# Long random string — CHANGE THIS
JWT_SECRET=replace-with-64-random-characters

# OTP: dev (always 123456) | msg91 | twilio
OTP_PROVIDER=dev
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push notifications via Expo push service (needs EAS projectId in the app)
EXPO_PUSH_ENABLED=false

